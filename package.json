{
  "name": "smugglers-ledger",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "description": "The Smuggler's Ledger — one searchable overview of everything you own across the whole of Cairn",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "version:check": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs bump"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@unocss/reset": "^66.8.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@unocss/preset-attributify": "^66.8.1",
    "@unocss/preset-icons": "^66.8.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.11.6",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "~5.6.2",
    "unocss": "^66.8.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
