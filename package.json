{
  "name": "smugglers-ledger",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "description": "The Smuggler's Ledger — one searchable overview of everything you own across the whole of Cairn",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "version:check": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs bump"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@unocss/reset": "^66.11.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@unocss/preset-attributify": "^66.10.2",
    "@unocss/preset-icons": "^66.10.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.6",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "~5.6.2",
    "unocss": "^66.11.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
