{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Smuggler’s Ledger",
  "version": "0.1.0",
  "identifier": "nl.zmuuzn.smugglers-ledger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "The Smuggler’s Ledger",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Zmuuzn Laboratory",
    "category": "Utility",
    "shortDescription": "One searchable overview of everything you own across the whole of Cairn.",
    "longDescription": "The Smuggler’s Ledger reads your own Grim Dawn saves — every character, every bag, every stash tab — resolves display names from your own local game install, and answers ‘where is my Ectoplasm’ without launching the game. Strictly read-only: the Ledger opens save files to read them and never for anything else. Zero configuration: it finds your saves and your install by itself.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
